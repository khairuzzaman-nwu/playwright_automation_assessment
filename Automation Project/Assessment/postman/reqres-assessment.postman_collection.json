{
  "info": {
    "_postman_id": "reqres-assessment-collection-2026",
    "name": "Reqres API Automation Assessment",
    "description": "Postman/Newman assessment suite. Every request asserts the response status. Requests run sequentially; Reqres is a hosted demo API and data updates are simulated.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Q3 - Login and capture authToken",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Login returns 200', () => pm.response.to.have.status(200));",
              "const data = pm.response.json();",
              "pm.test('authToken exists', () => pm.expect(data.token).to.be.a('string').and.not.empty);",
              "pm.environment.set('authToken', data.token);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "x-api-key",
            "value": "{{apiKey}}",
            "type": "text"
          },
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/login",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "login"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "Q4 - Get user by userId and verify name/email",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('GET user returns 200', () => pm.response.to.have.status(200));",
              "const user = pm.response.json().data;",
              "pm.test('Name matches stored expectedName', () => pm.expect(user.first_name + ' ' + user.last_name).to.eql(pm.environment.get('expectedName')));",
              "pm.test('Email matches stored expectedEmail', () => pm.expect(user.email).to.eql(pm.environment.get('expectedEmail')));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "x-api-key",
            "value": "{{apiKey}}",
            "type": "text"
          },
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/users/{{userId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "users",
            "{{userId}}"
          ]
        }
      }
    },
    {
      "name": "Q5 - PUT update profile and verify updatedAt",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('PUT returns 200', () => pm.response.to.have.status(200));",
              "const data = pm.response.json();",
              "pm.test('Updated name is returned', () => pm.expect(data.name).to.eql(pm.environment.get('updatedName')));",
              "pm.test('Updated job is returned', () => pm.expect(data.job).to.eql(pm.environment.get('updatedJob')));",
              "pm.test('updatedAt is a valid timestamp', () => { pm.expect(data.updatedAt).to.be.a('string').and.not.empty; pm.expect(Date.parse(data.updatedAt)).to.not.be.NaN; });",
              "pm.environment.set('updatedAt', data.updatedAt);"
            ]
          }
        }
      ],
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "x-api-key",
            "value": "{{apiKey}}",
            "type": "text"
          },
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/users/{{userId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "users",
            "{{userId}}"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"{{updatedName}}\",\n  \"job\": \"{{updatedJob}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "Q6 - PATCH single field and verify only field changed",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('PATCH returns 200', () => pm.response.to.have.status(200));",
              "const data = pm.response.json();",
              "pm.test('Requested job field changed', () => pm.expect(data.job).to.eql(pm.environment.get('patchJob')));",
              "pm.test('Response only contains the patched field plus server metadata', () => { pm.expect(data).to.have.property('job'); pm.expect(data).to.have.property('updatedAt'); pm.expect(data).not.to.have.property('name'); });"
            ]
          }
        }
      ],
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "x-api-key",
            "value": "{{apiKey}}",
            "type": "text"
          },
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/users/{{userId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "users",
            "{{userId}}"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"job\": \"{{patchJob}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
