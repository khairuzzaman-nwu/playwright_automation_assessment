{
  "name": "saucedemo-reqres-automation-assessment",
  "version": "1.0.0",
  "private": true,
  "description": "SauceDemo UI automation with Playwright POM and Reqres API automation with Postman/Newman",
  "scripts": {
    "install:browsers": "playwright install chromium",
    "test": "playwright test",
    "test:ui:q1": "playwright test tests/ui/locked-out.spec.js",
    "test:ui:q2": "playwright test tests/ui/standard-user-checkout.spec.js",
    "test:ui:q3": "playwright test tests/ui/performance-glitch-checkout.spec.js",
    "test:ui:all": "playwright test tests/ui",
    "test:ui:headed": "playwright test --headed",
    "report": "playwright show-report",
    "api": "newman run postman/reqres-assessment.postman_collection.json -e postman/reqres-local.postman_environment.json --reporters cli,htmlextra --reporter-htmlextra-export reports/reqres-api-report.html"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "newman": "^6.2.1",
    "newman-reporter-htmlextra": "^1.23.1"
  }
}